<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Sua Data Source theo ten SQL Server tren may ban, vi du .\SQLEXPRESS -->
    <add name="CafePOS"
         connectionString="Data Source=.;Initial Catalog=CafePOSDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
